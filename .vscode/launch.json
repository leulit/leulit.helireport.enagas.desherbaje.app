{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // HMAC_SECRET no se hardcodea aquí: --dart-define-from-file lo lee de .env
    // (raíz del proyecto), única fuente del secreto — igual que los build-*.sh.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "desherbaje (debug + HMAC)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "desherbaje (profile + HMAC)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "desherbaje (release + HMAC)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=.env"
            ]
        }
    ]
}
